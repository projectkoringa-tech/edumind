{
  "entities": {
    "User": {
      "title": "Perfil do Usuário",
      "description": "Informações da conta e progresso acadêmico.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "age": { "type": "number" },
        "academicLevel": { "type": "string" },
        "country": { "type": "string" },
        "province": { "type": "string" },
        "school": { "type": "string" },
        "xp": { "type": "number", "default": 0 },
        "level": { "type": "number", "default": 1 },
        "streak": { "type": "number", "default": 0 },
        "dailyXP": { "type": "number", "default": 0 },
        "lastXPDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "academicLevel", "country"]
    },
    "Discipline": {
      "title": "Disciplina",
      "description": "Matérias adicionadas pelo usuário.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name"]
    },
    "Schedule": {
      "title": "Horário",
      "description": "Entrada no calendário semanal.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "dayOfWeek": { "type": "number", "description": "0-6 (Dom-Sab)" },
        "startTime": { "type": "string", "description": "HH:mm" },
        "endTime": { "type": "string", "description": "HH:mm" }
      },
      "required": ["id", "userId", "disciplineId", "dayOfWeek", "startTime", "endTime"]
    },
    "Material": {
      "title": "Material de Estudo",
      "description": "PDFs, links ou imagens de suporte.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "type": { "type": "string", "enum": ["pdf", "image", "text", "link"] },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "type", "title"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "Cartão de revisão ativa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "theme": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "theme", "question", "answer"]
    },
    "Summary": {
      "title": "Resumo",
      "description": "Resumos de lições.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "theme": { "type": "string" },
        "content": { "type": "string" },
        "source": { "type": "string", "enum": ["manual", "ai"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "theme", "content"]
    },
    "Task": {
      "title": "Tarefa",
      "description": "Exercícios acadêmicos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "theme": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "userAnswer": { "type": "string" },
        "correction": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "theme", "content", "status"]
    },
    "ChatMessage": {
      "title": "Mensagem do Chat",
      "description": "Conversas com o Tutor IA.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "role", "content", "createdAt"]
    },
    "StudySession": {
      "title": "Sessão de Estudo",
      "description": "Log de tempo focado.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "theme": { "type": "string" },
        "content": { "type": "string" },
        "timeSpent": { "type": "number" },
        "isActive": { "type": "boolean" },
        "lastAccessed": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "theme", "content", "isActive", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": { "schema": "User", "description": "Perfis dos usuários" },
    "disciplines/{disciplineId}": { "schema": "Discipline", "description": "Disciplinas" },
    "schedules/{scheduleId}": { "schema": "Schedule", "description": "Horários" },
    "materials/{materialId}": { "schema": "Material", "description": "Materiais" },
    "flashcards/{flashcardId}": { "schema": "Flashcard", "description": "Flashcards" },
    "summaries/{summaryId}": { "schema": "Summary", "description": "Resumos" },
    "tasks/{taskId}": { "schema": "Task", "description": "Tarefas" },
    "chats/{messageId}": { "schema": "ChatMessage", "description": "Mensagens" },
    "study_sessions/{sessionId}": { "schema": "StudySession", "description": "Sessões" }
  }
}
