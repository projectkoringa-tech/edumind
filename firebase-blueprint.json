{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and school details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "academicLevel": { "type": "string" },
        "country": { "type": "string" },
        "province": { "type": "string" },
        "school": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "academicLevel", "country"]
    },
    "Discipline": {
      "title": "Subject / Discipline",
      "description": "Academic subjects added by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name"]
    },
    "Schedule": {
      "title": "School Schedule Entry",
      "description": "Weekly schedule entry for a discipline.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "dayOfWeek": { "type": "number", "description": "0-6 (Sun-Sat)" },
        "startTime": { "type": "string", "description": "HH:mm" },
        "endTime": { "type": "string", "description": "HH:mm" }
      },
      "required": ["id", "userId", "disciplineId", "dayOfWeek", "startTime", "endTime"]
    },
    "Material": {
      "title": "Study Material",
      "description": "Support resources like PDFs, images, or links.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "type": { "type": "string", "enum": ["pdf", "image", "text", "link"] },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "type", "title"]
    },
    "Flashcard": {
      "title": "Flashcard",
      "description": "Question and answer pair for active recall.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "theme": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "theme", "question", "answer"]
    },
    "Summary": {
      "title": "Summary",
      "description": "Lesson summaries generated or written by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "theme": { "type": "string" },
        "content": { "type": "string" },
        "source": { "type": "string", "enum": ["manual", "ai"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "theme", "content"]
    },
    "Task": {
      "title": "Task",
      "description": "Exercises or homework assigned or generated.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "theme": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "userAnswer": { "type": "string" },
        "correction": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "theme", "content", "status"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Messages exchanged with the AI Tutor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "role", "content", "createdAt"]
    },
    "StudySession": {
      "title": "Study Session",
      "description": "Paused or ongoing study sessions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "disciplineId": { "type": "string" },
        "theme": { "type": "string" },
        "content": { "type": "string" },
        "baseKnowledge": { "type": "string" },
        "timeSpent": { "type": "number", "description": "Seconds spent studying" },
        "isActive": { "type": "boolean" },
        "lastAccessed": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "disciplineId", "theme", "content", "isActive", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Unique profiles for each user."
    },
    "disciplines/{disciplineId}": {
      "schema": "Discipline",
      "description": "Subjects added by users."
    },
    "schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Weekly schedule slots."
    },
    "materials/{materialId}": {
      "schema": "Material",
      "description": "Study resources."
    },
    "flashcards/{flashcardId}": {
      "schema": "Flashcard",
      "description": "Active recall cards."
    },
    "summaries/{summaryId}": {
      "schema": "Summary",
      "description": "Study summaries."
    },
    "tasks/{taskId}": {
      "schema": "Task",
      "description": "Academic tasks and exercises."
    },
    "chats/{messageId}": {
      "schema": "ChatMessage",
      "description": "History of conversations with the Tutor."
    },
    "study_sessions/{sessionId}": {
      "schema": "StudySession",
      "description": "Ongoing or paused study sessions."
    }
  }
}
