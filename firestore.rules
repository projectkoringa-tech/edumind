rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incomingData() {
      return request.resource.data;
    }

    function existingData() {
      return resource.data;
    }

    // --- Validation Helpers ---
  function isValidUser(data) {
    return (data.get('id', null) == null || data.id is string) &&
           (data.get('name', null) == null || (data.name is string && data.name.size() >= 1 && data.name.size() <= 100)) &&
           (data.get('email', null) == null || (data.email is string && data.email.size() <= 256)) &&
           (data.get('academicLevel', null) == null || data.academicLevel is string) &&
           (data.get('country', null) == null || data.country is string) &&
           (data.get('province', null) == null || data.province is string) &&
           (data.get('school', null) == null || data.school is string) &&
           (data.get('age', null) == null || data.age is number) &&
           (data.get('xp', null) == null || data.xp is number) &&
           (data.get('level', null) == null || data.level is number) &&
           (data.get('relaxoXP', null) == null || data.relaxoXP is number) &&
           (data.get('relaxoLevel', null) == null || data.relaxoLevel is number) &&
           (data.get('relaxoTimeMinutes', null) == null || data.relaxoTimeMinutes is number) &&
           (data.get('streak', null) == null || data.streak is number) &&
           (data.get('dailyXP', null) == null || data.dailyXP is number) &&
           (data.get('lastXPDate', null) == null || data.lastXPDate is string) &&
           (data.get('createdAt', null) == null || data.createdAt is timestamp || data.createdAt is string) &&
           (data.get('updatedAt', null) == null || data.updatedAt is timestamp || data.updatedAt is string);
  }

    function isValidDiscipline(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.color is string && data.color.size() <= 20;
    }

    function isValidSchedule(data) {
      return data.userId == request.auth.uid &&
             data.disciplineId is string &&
             data.dayOfWeek is number && data.dayOfWeek >= 0 && data.dayOfWeek <= 6 &&
             data.startTime is string && data.endTime is string;
    }

    function isValidMaterial(data) {
      return data.userId == request.auth.uid &&
             data.disciplineId is string &&
             data.title is string && data.title.size() > 0 &&
             data.type is string &&
             (data.url == null || data.url is string);
    }

    function isValidFlashcard(data) {
      return data.userId == request.auth.uid &&
             data.disciplineId is string &&
             data.question is string && data.question.size() > 0 &&
             data.answer is string && data.answer.size() > 0;
    }

    function isValidSummary(data) {
      return data.userId == request.auth.uid &&
             data.disciplineId is string &&
             data.content is string && data.content.size() > 0 &&
             data.source in ["manual", "automated"];
    }

    function isValidTask(data) {
      return data.userId == request.auth.uid &&
             data.disciplineId is string &&
             data.content is string && data.content.size() > 0 &&
             data.status in ["pending", "completed"];
    }

    function isValidChatMessage(data) {
      return data.userId == request.auth.uid &&
             data.role in ["user", "assistant"] &&
             data.content is string && data.content.size() > 0;
    }

    function isValidStudySession(data) {
      return data.userId == request.auth.uid &&
             data.disciplineId is string &&
             data.theme is string && data.theme.size() > 0 &&
             data.content is string &&
             data.isActive is bool;
    }

    function isValidRelaxoProfile(data) {
      return data.userId == request.auth.uid &&
             data.xp is number &&
             data.level is number;
    }

    // --- Collections ---

    match /users/{userId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incomingData()) && 
                      incomingData().createdAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incomingData());
    }

    match /relaxo_profiles/{userId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(userId) && isOwner(userId) && isValidRelaxoProfile(incomingData());
      allow update: if isValidId(userId) && isOwner(userId) && isValidRelaxoProfile(incomingData()) &&
                      incomingData().userId == existingData().userId &&
                      incomingData().diff(existingData()).affectedKeys().hasOnly(['xp', 'level', 'gamesPlayed', 'updatedAt']);
    }

    match /disciplines/{disciplineId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isValidId(disciplineId) && isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(disciplineId) && isSignedIn() && isValidDiscipline(incomingData()) && incomingData().createdAt == request.time;
      allow update: if isValidId(disciplineId) && isSignedIn() && existingData().userId == request.auth.uid &&
                      isValidDiscipline(incomingData()) &&
                      incomingData().userId == existingData().userId &&
                      incomingData().diff(existingData()).affectedKeys().hasOnly(['name', 'color']);
      allow delete: if isValidId(disciplineId) && isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /schedules/{scheduleId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isValidId(scheduleId) && isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(scheduleId) && isSignedIn() && isValidSchedule(incomingData());
      allow update: if isValidId(scheduleId) && isSignedIn() && existingData().userId == request.auth.uid &&
                      isValidSchedule(incomingData()) &&
                      incomingData().userId == existingData().userId;
      allow delete: if isValidId(scheduleId) && isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /materials/{materialId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isValidId(materialId) && isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(materialId) && isSignedIn() && isValidMaterial(incomingData()) && incomingData().createdAt == request.time;
      allow update: if isValidId(materialId) && isSignedIn() && existingData().userId == request.auth.uid &&
                      isValidMaterial(incomingData()) &&
                      incomingData().userId == existingData().userId;
      allow delete: if isValidId(materialId) && isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /flashcards/{flashcardId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isValidId(flashcardId) && isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(flashcardId) && isSignedIn() && isValidFlashcard(incomingData()) && incomingData().createdAt == request.time;
      allow update: if isValidId(flashcardId) && isSignedIn() && existingData().userId == request.auth.uid &&
                      isValidFlashcard(incomingData()) &&
                      incomingData().userId == existingData().userId;
      allow delete: if isValidId(flashcardId) && isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /summaries/{summaryId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isValidId(summaryId) && isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(summaryId) && isSignedIn() && isValidSummary(incomingData()) && incomingData().createdAt == request.time;
      allow update: if isValidId(summaryId) && isSignedIn() && existingData().userId == request.auth.uid &&
                      isValidSummary(incomingData()) &&
                      incomingData().userId == existingData().userId;
      allow delete: if isValidId(summaryId) && isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isValidId(taskId) && isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(taskId) && isSignedIn() && isValidTask(incomingData()) && incomingData().createdAt == request.time;
      allow update: if isValidId(taskId) && isSignedIn() && existingData().userId == request.auth.uid &&
                      isValidTask(incomingData()) &&
                      incomingData().userId == existingData().userId &&
                      incomingData().updatedAt == request.time &&
                      incomingData().diff(existingData()).affectedKeys().hasOnly(['userAnswer', 'correction', 'status', 'updatedAt']);
      allow delete: if isValidId(taskId) && isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /chats/{messageId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isValidId(messageId) && isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(messageId) && isSignedIn() && isValidChatMessage(incomingData()) && incomingData().createdAt == request.time;
      allow update, delete: if false; // Messages are immutable
    }

    match /study_sessions/{sessionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isValidId(sessionId) && isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isValidId(sessionId) && isSignedIn() && isValidStudySession(incomingData()) && incomingData().createdAt == request.time;
      allow update: if isValidId(sessionId) && isSignedIn() && existingData().userId == request.auth.uid &&
                      isValidStudySession(incomingData()) &&
                      incomingData().userId == existingData().userId &&
                      incomingData().diff(existingData()).affectedKeys().hasOnly(['content', 'isActive', 'timeSpent', 'lastAccessed', 'updatedAt']);
      allow delete: if isValidId(sessionId) && isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
